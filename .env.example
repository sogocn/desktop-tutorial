# 自托管后端环境变量（server/index.ts 与 server/migrate.ts 读取）
# 复制为 .env 后填真实值；部署到轻量云时写在 API 服务的环境变量里。

# Postgres 连接串（自托管实例上的本机库）
DATABASE_URL=postgres://familyquest:CHANGE_ME@127.0.0.1:5432/familyquest

# JWT 签名密钥：务必改成随机长串，且不要提交进仓库
JWT_SECRET=please-change-to-a-long-random-string

# API 监听端口（nginx 反代会指向这里）
PORT=3000
